# Backend Varlock schema.
#
# @defaultSensitive=false @defaultRequired=false
# @currentEnv=$APP_ENV
# ---

# @public @type=enum(local,dev,staging,prod)
APP_ENV=dev

# Metadata.
# @public
METADATA_NAME="SKN28 Backend"
# @public
METADATA_VERSION="0.1.0"

# Runtime.
# @public
RUNTIME_HOST="127.0.0.1"
# @public @type=port
RUNTIME_PORT=8000
# @public @type=boolean
RUNTIME_RELOAD=false
# @public
RUNTIME_LOG_LEVEL="INFO"
# @public
RUNTIME_CORS_ORIGINS='["http://localhost:8501","http://127.0.0.1:8501","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]'

# LLM / OpenRouter credential.
# @sensitive
OPENROUTER_API_KEY=
# LLM / Cerebras credential.
# @sensitive
CEREBRAS_API_KEY=

# LLM / agent model settings.
# @public @type=enum(openrouter,cerebras)
LLM_CHAT_PROVIDER="openrouter"
# @public
LLM_CHAT_MODEL="openai/gpt-oss-120b"
# @public @type=number
LLM_CHAT_TEMPERATURE=0.2
# @public @type=number
LLM_CHAT_TIMEOUT_MS=60000
# @public @type=number
LLM_CHAT_MAX_RETRIES=2
# Empty string is treated as no max token limit by backend settings.
# @public
LLM_CHAT_MAX_TOKENS=""
# @public
LLM_CHAT_REASONING_EFFORT=""
# Empty string inherits LLM_CHAT_PROVIDER.
# @public
LLM_SPEECH_TEXT_PROVIDER=""
# @public
LLM_SPEECH_TEXT_MODEL="openai/gpt-oss-120b"
# @public @type=number
LLM_SPEECH_TEXT_TEMPERATURE=0.0
# @public @type=number
LLM_SPEECH_TEXT_TIMEOUT_MS=60000
# @public @type=number
LLM_SPEECH_TEXT_MAX_RETRIES=2
# Empty string is treated as no max token limit by backend settings.
# @public
LLM_SPEECH_TEXT_MAX_TOKENS=""
# @public
LLM_SPEECH_TEXT_REASONING_EFFORT=""

# LLM / provider settings.
# @public
LLM_OPENROUTER_APP_TITLE="SKN28 Backend Agent"
# @public @type=url
LLM_OPENROUTER_APP_URL="https://openrouter.ai/openai/gpt-oss-120b"
# @public @type=url
LLM_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# @public
LLM_OPENROUTER_PROVIDER_ORDER='["cerebras"]'
# @public @type=boolean
LLM_OPENROUTER_ALLOW_FALLBACKS=true
# @public @type=boolean
LLM_OPENROUTER_REQUIRE_PARAMETERS=false

# Empty string uses the SDK default endpoint.
# @public
LLM_CEREBRAS_BASE_URL=""

# ElevenLabs TTS.
# @sensitive
ELEVENLABS_API_KEY=
# Voice IDs are provider identifiers, not credentials.
# @public
ELEVENLABS_VOICE_ID=
# @public
ELEVENLABS_TTS_MODEL_ID="eleven_flash_v2_5"
# @public @type=url
ELEVENLABS_TTS_WS_BASE_URL="wss://api.elevenlabs.io/v1/text-to-speech"
# @public
ELEVENLABS_OUTPUT_FORMAT="mp3_44100_128"
# @public @type=number
ELEVENLABS_STABILITY=0.5
# @public @type=number
ELEVENLABS_SIMILARITY_BOOST=0.6
# @public @type=number
ELEVENLABS_STYLE=0.0
# @public @type=number
ELEVENLABS_SPEED=1.05
# @public @type=boolean
ELEVENLABS_USE_SPEAKER_BOOST=true

# RAG MCP tool integration.
# @public @type=url
RAG_MCP_URL="http://127.0.0.1:8010/mcp"
# @public @type=boolean
RAG_TOOLS_ENABLED=true
# @public @type=number
RAG_TOOL_TIMEOUT_MS=30000
