# Backend Varlock schema.
#
# @defaultSensitive=false @defaultRequired=false
# @currentEnv=$APP_ENV
# ---

# @public @type=enum(local,dev,staging,prod)
APP_ENV=dev

# Metadata.
# @public
METADATA_NAME="SKN28 Backend"
# @public
METADATA_VERSION="0.1.0"

# Runtime.
# @public
RUNTIME_HOST="127.0.0.1"
# @public @type=port
RUNTIME_PORT=8000
# @public @type=boolean
RUNTIME_RELOAD=false
# @public
RUNTIME_LOG_LEVEL="INFO"
# @public
RUNTIME_CORS_ORIGINS='["http://localhost:8501","http://127.0.0.1:8501","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]'

# LLM / provider credentials.
# @sensitive
LLM_PROVIDER_OPENAI_API_KEY=
# @sensitive
LLM_PROVIDER_OPENROUTER_API_KEY=
# @sensitive
LLM_PROVIDER_CEREBRAS_API_KEY=

# LLM / agent model selection.
# @public @type=enum(openai,openrouter,cerebras)
LLM_AGENT_MAIN_PROVIDER="cerebras"
# @public
LLM_AGENT_MAIN_MODEL="gpt-oss-120b"
# @public @type=enum(openai,openrouter,cerebras)
LLM_AGENT_SANITIZE_PROVIDER="openrouter"
# @public
LLM_AGENT_SANITIZE_MODEL="openai/gpt-oss-20b"
# @public @type=enum(openai,openrouter,cerebras)
LLM_AGENT_WINDOW_PROVIDER="cerebras"
# @public
LLM_AGENT_WINDOW_MODEL="gpt-oss-120b"

# LLM / shared request and response settings.
# @public @type=number
LLM_REQUEST_TIMEOUT_MS=60000
# @public @type=number
LLM_REQUEST_MAX_RETRIES=2
# Empty string is treated as no max token limit by backend settings.
# @public
LLM_RESPONSE_MAX_TOKENS=""

# LLM / provider settings.
# Empty string uses the SDK default endpoint.
# @public
LLM_PROVIDER_OPENAI_BASE_URL=""
# @public
LLM_PROVIDER_OPENROUTER_APP_TITLE="SKN28 Backend Agent"
# Empty string omits OpenRouter HTTP-Referer metadata.
# @public
LLM_PROVIDER_OPENROUTER_APP_URL=""
# @public @type=url
LLM_PROVIDER_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# @public
LLM_PROVIDER_OPENROUTER_PROVIDER_ORDER='["groq"]'
# @public @type=boolean
LLM_PROVIDER_OPENROUTER_ALLOW_FALLBACKS=true
# @public @type=boolean
LLM_PROVIDER_OPENROUTER_REQUIRE_PARAMETERS=false

# Empty string uses the SDK default endpoint.
# @public
LLM_PROVIDER_CEREBRAS_BASE_URL=""

# ElevenLabs TTS.
# @sensitive
ELEVENLABS_API_KEY=
# Voice IDs are provider identifiers, not credentials.
# @public
ELEVENLABS_VOICE_ID=
# Empty string uses the SDK default production endpoint.
# @public
ELEVENLABS_BASE_URL=""
# @public
ELEVENLABS_TTS_MODEL_ID="eleven_flash_v2_5"
# @public
ELEVENLABS_OUTPUT_FORMAT="mp3_44100_128"
# @public @type=number
ELEVENLABS_STABILITY=0.5
# @public @type=number
ELEVENLABS_SIMILARITY_BOOST=0.6
# @public @type=number
ELEVENLABS_STYLE=0.0
# @public @type=number
ELEVENLABS_SPEED=1.05
# @public @type=boolean
ELEVENLABS_USE_SPEAKER_BOOST=true

# RAG MCP tool integration.
# @public @type=url
RAG_MCP_URL="http://127.0.0.1:8010/mcp"
# @public @type=boolean
RAG_TOOLS_ENABLED=true
# @public @type=number
RAG_TOOL_TIMEOUT_MS=30000

# External MCP tool integration.
# @public @type=url
EXTERNAL_MCP_URL="http://127.0.0.1:8020/"
# @public @type=boolean
EXTERNAL_MCP_TOOLS_ENABLED=true
# @public @type=number
EXTERNAL_MCP_TOOL_TIMEOUT_MS=30000
