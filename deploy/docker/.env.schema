# Integrated deploy Varlock schema.
#
# @defaultSensitive=false @defaultRequired=false
# @currentEnv=$APP_ENV
# ---

# @public @type=enum(local,dev,demo,prod)
APP_ENV=local

# @public
MEMGRAPH_PUBLISH_HOST=127.0.0.1
# @public
MEMGRAPH_IMAGE=memgraph/memgraph-mage:latest
# @public
MEMGRAPH_CONTAINER_NAME=rag-memgraph
# @public @type=port
MEMGRAPH_BOLT_PORT=7687
# @public @type=port
MEMGRAPH_LOG_PORT=7444
# @public
MEMGRAPH_LOG_LEVEL=INFO
# @public @type=boolean
MEMGRAPH_SCHEMA_INFO_ENABLED=true

# @public
MEMGRAPH_LAB_IMAGE=memgraph/lab:latest
# @public
MEMGRAPH_LAB_CONTAINER_NAME=rag-memgraph-lab
# @public @type=port
MEMGRAPH_LAB_PORT=3001

# @public
REDIS_IMAGE=redis:7-alpine
# @public
REDIS_CONTAINER_NAME=rag-redis
# @public
REDIS_PUBLISH_HOST=127.0.0.1
# @public @type=port
REDIS_PORT=6379

# @public
RAG_BE_PUBLISH_HOST=127.0.0.1
# @public @type=port
RAG_BE_HOST_PORT=8110

# @public
BACKEND_PUBLISH_HOST=127.0.0.1
# @public @type=port
BACKEND_HOST_PORT=8100

# @public
FRONTEND_PUBLISH_HOST=127.0.0.1
# @public @type=port
FRONTEND_HOST_PORT=3000
# Browser-facing backend URL used by the frontend bundle.
# @public @type=url
FRONTEND_PUBLIC_BACKEND_URL=http://127.0.0.1:8100

# Legacy Streamlit profile only.
# @public
STREAMLIT_PUBLISH_HOST=0.0.0.0
# @public @type=port
STREAMLIT_HOST_PORT=8501

# @public
RAG_FE_PUBLISH_HOST=127.0.0.1
# @public @type=port
RAG_FE_HOST_PORT=5174
# @public @type=url
RAG_FE_PUBLIC_RAG_API_BASE_URL=http://127.0.0.1:8110
