# Frontend Migration Varlock schema.
#
# @defaultSensitive=false @defaultRequired=false
# @currentEnv=$APP_ENV
# ---

# @public @type=enum(local,dev,staging,prod)
APP_ENV=dev

# Public browser path for the local Next.js chat BFF route.
# @public
NEXT_PUBLIC_CHAT_API_PATH="/api/chat"

# Public Naver Cloud Platform Maps Web Dynamic Map key ID.
# Browser-exposed by design; do not put server API secrets here.
# @public
NEXT_PUBLIC_NAVER_MAP_NCP_KEY_ID=

# Optional legacy alias for older Naver Maps applications.
# Prefer NEXT_PUBLIC_NAVER_MAP_NCP_KEY_ID for new NCP apps.
# @public
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Server-side backend base URL used by the App Router chat BFF.
# @type=url
BFF_BACKEND_BASE_URL="http://127.0.0.1:8000"

# Server-side backend chat stream path used by the App Router chat BFF.
# @public
BFF_BACKEND_CHAT_STREAM_PATH="/chat/stream"

# Server-side ElevenLabs key reserved for BFF-owned voice operations.
# @sensitive
BFF_ELEVENLABS_API_KEY=
