# Maps MCP Varlock schema.
#
# @defaultSensitive=false @defaultRequired=false
# @currentEnv=$APP_ENV
# ---

# @public @type=enum(local,dev,staging,prod)
APP_ENV=local

# Maps MCP runtime bind.
# @public
MAPS_MCP_HOST="127.0.0.1"
# @public @type=port
MAPS_MCP_PORT=8020
# @public
MAPS_EXTERNAL_MCP_PATH="/mcp"
# @public
MAPS_CORS_ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
# @public @type=number
MAPS_API_REQUEST_TIMEOUT_MS=5000

# Naver Search API credentials. Do not use the browser Naver Maps JS key here.
# @sensitive @required=forEnv(staging,prod)
NAVER_SEARCH_CLIENT_ID=
# @sensitive @required=forEnv(staging,prod)
NAVER_SEARCH_CLIENT_SECRET=
# @public @type=url
NAVER_LOCAL_BASE_URL="https://openapi.naver.com/v1/search/local.json"

# TMAP Open API credentials and provider endpoints.
# @sensitive @required=forEnv(staging,prod)
TMAP_APP_KEY=
# @public @type=url
TMAP_BASE_URL="https://apis.openapi.sk.com"
# @public
TMAP_POI_SEARCH_PATH="/tmap/pois"
# @public
TMAP_PEDESTRIAN_ROUTE_PATH="/tmap/routes/pedestrian"
# @public
TMAP_CAR_ROUTE_PATH="/tmap/routes"
