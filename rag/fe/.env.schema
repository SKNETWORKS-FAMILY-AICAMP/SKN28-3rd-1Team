VITE_RAG_API_TIMEOUT_MS=1500
# @public @type=boolean
VITE_RAG_ENABLE_MOCK_FALLBACK=true
# @public @type=url
VITE_MEMGRAPH_LAB_URL="http://127.0.0.1:3000"
