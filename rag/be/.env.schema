# RAG backend Varlock schema.
#
# @defaultSensitive=false @defaultRequired=false
# @currentEnv=$APP_ENV
# ---

# @public @type=enum(local,dev,demo,prod)
APP_ENV=local

# RAG service directories.
# @public
RAG_WORKSPACE_DIR="./workspace"
# @public
RAG_INPUT_DIR="./input"
# @public
RAG_OUTPUT_DIR="./output"
# @public
RAG_CACHE_DIR="./cache"

# Memgraph connection.
# @public
RAG_MEMGRAPH_URI="bolt://127.0.0.1:7687"
# @public
RAG_MEMGRAPH_USERNAME=""
# @sensitive
RAG_MEMGRAPH_PASSWORD=

# Redis-backed job observability streams.
# @public @type=url
RAG_REDIS_URL="redis://127.0.0.1:6379/0"
# @public @type=boolean
RAG_OBSERVABILITY_ENABLED=true
# @public
RAG_OBSERVABILITY_STREAM_PREFIX="rag:observability:jobs"
# @public @type=number
RAG_OBSERVABILITY_STREAM_MAXLEN=2000
# @public @type=number
RAG_OBSERVABILITY_STREAM_TTL_SECONDS=3600
# @public @type=number
RAG_OBSERVABILITY_XREAD_BLOCK_MS=15000

# OpenRouter / model settings.
# @sensitive @required=forEnv(dev,demo,prod)
RAG_OPENROUTER_API_KEY=
# @public @type=url
RAG_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# @public
RAG_GRAPH_LLM_MODEL="openai/gpt-oss-120b"
# @public
RAG_GRAPH_LLM_PROVIDER="groq"
# @public @type=boolean
RAG_GRAPH_LLM_PROVIDER_ALLOW_FALLBACKS=true
# @public @type=boolean
RAG_GRAPH_LLM_RETRY_WITHOUT_PROVIDER=true
# @public @type=number
RAG_GRAPH_LLM_REQUEST_TIMEOUT_SECONDS=60
# @public @type=number
RAG_GRAPH_LLM_STREAM_CHUNK_TIMEOUT_SECONDS=60
# @public @type=number
RAG_GRAPH_LLM_MAX_RETRIES=2
# @public
RAG_GRAPH_LLM_THINKING=""

# Optional per-agent overrides.
# @public
RAG_CHUNKING_AGENT_LLM_MODEL="deepseek/deepseek-v4-pro"
# @public
RAG_CHUNKING_AGENT_LLM_PROVIDER="deepseek"
# @public @type=boolean
RAG_CHUNKING_AGENT_LLM_PROVIDER_ALLOW_FALLBACKS=true
# @public @type=boolean
RAG_CHUNKING_AGENT_LLM_RETRY_WITHOUT_PROVIDER=true
# @public
RAG_CHUNKING_AGENT_LLM_THINKING="disabled"

# Embedding.
# @public
RAG_EMBEDDING_MODEL="openai/text-embedding-3-large"
# @public @type=number
RAG_EMBEDDING_DIMENSIONS=3072
# @public @type=number
RAG_EMBEDDING_WORKER_COUNT=5

# Firecrawl web search tool for graph candidate evidence discovery.
# @sensitive
RAG_FIRECRAWL_API_KEY=
# @public @type=number
RAG_FIRECRAWL_REQUEST_TIMEOUT_MS=15000
# @public @type=number
RAG_FIRECRAWL_SEARCH_DEFAULT_LIMIT=5
# @public @type=number
RAG_FIRECRAWL_SEARCH_MAX_LIMIT=10
# @public @type=number
RAG_FIRECRAWL_SEARCH_MARKDOWN_CHAR_LIMIT=1200

# FastMCP Streamable HTTP endpoint.
# @public
RAG_MCP_HOST="127.0.0.1"
# @public @type=port
RAG_MCP_PORT=8010
# @public
RAG_EXTERNAL_MCP_PATH="/mcp"
# @public
RAG_CORS_ALLOWED_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:5174","http://localhost:5174"]'

# Memgraph query execution guardrails.
# @public @type=number
RAG_QUERY_TIMEOUT_MS=30000
# @public @type=number
RAG_QUERY_MAX_ROWS=100
# @public
RAG_TEXT_SEARCH_INDEX_NAME="rag_text_idx"
# @public
RAG_DOCUMENT_TEXT_SEARCH_INDEX_NAME="rag_document_text_idx"
# @public
RAG_REVIEW_NOTE_TEXT_SEARCH_INDEX_NAME="rag_review_note_text_idx"
# @public @type=number
RAG_GRAPH_CANDIDATE_TOOL_BUDGET=80
# @public @type=number
RAG_MEMORY_UPDATE_AGENT_TOOL_BUDGET=40
# @public @type=number
RAG_GRAPH_CANDIDATE_WORKER_COUNT=8
# @public @type=number
RAG_KNOWLEDGE_BUILD_WORKER_COUNT=1
# @public @type=number
RAG_KNOWLEDGE_REVIEW_WORKER_COUNT=1
# @public @type=number
RAG_KNOWLEDGE_TASK_QUEUE_MAX_SIZE=100
# @public @type=number
RAG_GRAPH_CONSTRUCTION_WORKER_COUNT=1
# @public @type=number
RAG_GRAPH_REVIEW_WORKER_COUNT=1
# @public @type=number
RAG_GRAPH_TASK_QUEUE_MAX_SIZE=100

# Structured logging.
# @public
RAG_LOG_LEVEL="INFO"
# @public @type=boolean
RAG_LOG_JSON=true
