# Voice transcription Varlock schema.
#
# This file is safe to commit. Real secret values must live in a local
# gitignored .env file or Infisical.
#
# @defaultSensitive=false @defaultRequired=false
# @currentEnv=$APP_ENV
# ---

# @public @type=enum(local,dev,staging,prod)
APP_ENV=local

# @public @type=enum(elevenlabs,openrouter)
VOICE_TRANSCRIPTION_PROVIDER="elevenlabs"
# Empty string chooses the provider default in transcribe_vid_source.py.
# @public
VOICE_TRANSCRIPTION_MODEL=""
# Optional ISO-639 language code. Empty string lets the provider auto-detect.
# @public
VOICE_TRANSCRIPTION_LANGUAGE=""
# @public @type=number
VOICE_TRANSCRIPTION_CHUNK_SECONDS=60
# @public @type=number
VOICE_TRANSCRIPTION_START_SECONDS=0
# Empty string means process through the end of the input.
# @public
VOICE_TRANSCRIPTION_MAX_DURATION_SECONDS=""
# Used by ElevenLabs only.
# @public @type=boolean
VOICE_TRANSCRIPTION_DIARIZE=true
# Used by ElevenLabs only. Set to none to omit timestamp details.
# @public @type=enum(word,character,none)
VOICE_TRANSCRIPTION_TIMESTAMPS_GRANULARITY="word"
# @public
VOICE_TRANSCRIPTION_OUTPUT_DIR="outputs"
# @public
VOICE_TRANSCRIPTION_WORK_DIR="work/audio_chunks"

# ElevenLabs Speech-to-Text.
# @sensitive
ELEVENLABS_API_KEY=

# OpenRouter Speech-to-Text.
# @sensitive
LLM_PROVIDER_OPENROUTER_API_KEY=
# @public
LLM_PROVIDER_OPENROUTER_APP_TITLE="SKN28 Voice Transcription"
# Empty string omits OpenRouter HTTP-Referer metadata.
# @public
LLM_PROVIDER_OPENROUTER_APP_URL=""
