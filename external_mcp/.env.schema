# External MCP Varlock schema.
#
# @defaultSensitive=false @defaultRequired=false
# @currentEnv=$APP_ENV
# ---

# @public @type=enum(local,dev,staging,prod)
APP_ENV=local

# External MCP runtime bind.
# @public
EXTERNAL_MCP_HOST="127.0.0.1"
# @public @type=port
EXTERNAL_MCP_PORT=8020
# @public
EXTERNAL_MCP_PATH="/"

# Provider credentials. Actual values must live in Infisical/local ignored env only.
# @sensitive
EXTERNAL_MCP_NAVER_CLIENT_ID=
# @sensitive
EXTERNAL_MCP_NAVER_CLIENT_SECRET=
# @sensitive
EXTERNAL_MCP_FIRECRAWL_API_KEY=
# @sensitive
EXTERNAL_MCP_TMAP_APP_KEY=

# Request behavior.
# @public @type=number
EXTERNAL_MCP_REQUEST_TIMEOUT_MS=15000
# @public @type=number
EXTERNAL_MCP_SEARCH_DEFAULT_LIMIT=5
# @public @type=number
EXTERNAL_MCP_SEARCH_MAX_LIMIT=10
